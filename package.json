{
  "name": "moments-site",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run update-env && ng serve",
    "build": "npm run update-env && ng build && npm run post-build",
    "post-build": "powershell -Command \"Move-Item -Path 'docs/browser/*' -Destination 'docs/' -Force; Remove-Item -Path 'docs/browser' -Recurse -Force\"",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:MomentsSite": "node dist/MomentsSite/server/server.mjs",
    "update-env": "node scripts/update-environment.js"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.9.3",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/platform-server": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@angular/service-worker": "^21.1.0",
    "@angular/ssr": "^21.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^27.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}